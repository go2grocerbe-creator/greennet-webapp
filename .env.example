# Copy this file to .env.local for local development. Configure the same
# variables in Vercel for Preview and Production. Never commit real values.

# Site ------------------------------------------------------------------------
# Use the final HTTPS origin in production (no trailing path).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase --------------------------------------------------------------------
# Public values used for authenticated admin sessions and published content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only and required for validated quotation inserts. Anonymous RLS has
# no direct INSERT policy. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile --------------------------------------------------------
# Both values are required for production quotation submissions. The site key
# is public by design; the secret must remain server-only. Missing secrets fail
# closed in production and use a logged bypass only in development/test.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email -----------------------------------------------------------------------
# RESEND_API_KEY and EMAIL_FROM_ADDRESS must be configured together. If either
# is missing, the non-sending console provider is used.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Final recipient requires client approval. When unset, the verified public
# contact email in src/lib/config.ts is used.
QUOTE_NOTIFICATION_EMAIL=

# Optional integrations -------------------------------------------------------
# Keep analytics disabled until the client approves privacy/cookie wording.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Integration point reserved for the approved Sentry project.
SENTRY_DSN=
