# Copy to .env.local and fill in real values once the corresponding
# accounts exist. Never commit .env.local or real credentials — see
# docs/security-model.md "Secrets and environment variables".
# The app builds and runs without any of these; only Supabase-backed
# features (auth, admin, the quotation form's DB insert) need them.

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to client code. Not required for the public
# quotation form — that uses the anon key via an RLS insert policy.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudflare Turnstile (spam protection on /contact) ──────────────────
# Site key is public by design (rendered in the browser widget).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret is server-only. Without it, verification runs in an explicit
# dev/test bypass (logged) — see src/lib/turnstile/verify.ts. Never leave
# this unset in a real deployment.
TURNSTILE_SECRET_KEY=

# ── Email (quotation notification + acknowledgement) ─────────────────────
# Without RESEND_API_KEY, emails are logged to the server console instead
# of sent — see src/lib/email/index.ts.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Defaults to the confirmed GreenNet contact email (src/lib/config.ts) if unset.
QUOTE_NOTIFICATION_EMAIL=

# ── Analytics / error monitoring (integration points, not required) ──────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=
